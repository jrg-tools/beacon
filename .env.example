# Where the SQLite database (beacon.db) and the firmware cache (cache/) live. /data in Docker.
DATA_DIR=data
BIND=0.0.0.0:8080
# The admin UI's static build (`pnpm run build` in web/). /ui in Docker.
UI_DIR=web/build

# Fine-grained GitHub token with only "Contents: read" on the private firmware repos (not your gh CLI
# login, which can do far more). Optional for public repos (anonymous calls are limited to 60/hour).
# GITHUB_TOKEN=github_pat_...

# Clerk (https://dashboard.clerk.com → API keys), the same instance as jrg-life works. The admin page
# needs privateMetadata `role: "admin"` with `scope` (comma-separated apps) including CLERK_SCOPE.
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
# CLERK_SCOPE=beacon
# Where Beacon is served, comma-separated (a session token's `azp`). Set it when the Clerk instance
# also signs in other apps, so their tokens are refused here.
# CLERK_AUTHORIZED_PARTIES=https://beacon.example.com,http://localhost:8080

# How often every project's releases are re-read from GitHub (the admin page also has "Sync now").
# SYNC_INTERVAL_SECS=172800  # two days (the default)
# RUST_LOG=info
